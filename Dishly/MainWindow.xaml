<Window x:Class="Dishly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dishly"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        Background="{StaticResource Canvas}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedInk}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13">
                            <Grid>
                                <Border x:Name="Indicator"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="2"
                                        Background="{StaticResource Accent}"
                                        Opacity="0"
                                        Margin="0,9,0,9"/>
                                <ContentPresenter Margin="16,0,12,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter Property="Background" Value="#202722"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#29342D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#17120E"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#232A26"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="#2A312D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#0D100E"
                Padding="18,22,18,18">

            <DockPanel>

                <StackPanel DockPanel.Dock="Top">

                    <TextBlock Text="dishly"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"
                               Margin="2,0,0,0"/>

                    <TextBlock Text="cook something memorable"
                               Foreground="{StaticResource MutedInk}"
                               FontSize="11"
                               Margin="3,2,0,24"/>

                    <Button x:Name="NavHomeButton"
                            Style="{StaticResource NavButton}"
                            Click="Home_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="9"
                                    Background="#2D241D"
                                    VerticalAlignment="Center">
                                <TextBlock Text="01"
                                           Foreground="{StaticResource Accent}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="Home"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NavDiscoverButton"
                            Style="{StaticResource NavButton}"
                            Click="Discover_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="9"
                                    Background="#1D2420"
                                    VerticalAlignment="Center">
                                <TextBlock Text="02"
                                           Foreground="{StaticResource MutedInk}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="Discover"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NavFavoritesButton"
                            Style="{StaticResource NavButton}"
                            Click="Favorites_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="9"
                                    Background="#1D2420"
                                    VerticalAlignment="Center">
                                <TextBlock Text="03"
                                           Foreground="{StaticResource MutedInk}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="Favorites"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NavShoppingButton"
                            Style="{StaticResource NavButton}"
                            Click="Shopping_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="9"
                                    Background="#1D2420"
                                    VerticalAlignment="Center">
                                <TextBlock Text="04"
                                           Foreground="{StaticResource MutedInk}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="Shopping list"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NavMyRecipesButton"
                            Style="{StaticResource NavButton}"
                            Click="MyRecipes_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="9"
                                    Background="#1D2420"
                                    VerticalAlignment="Center">
                                <TextBlock Text="05"
                                           Foreground="{StaticResource MutedInk}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="My recipes"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1"
                            Background="#202520"
                            Margin="0,0,0,14"/>

                    <TextBlock Text="v0.3 • Dishly"
                               Foreground="#5E645E"
                               FontSize="10"
                               Margin="3,0,0,0"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <Grid Grid.Column="1"
              Margin="34,30,34,24">

            <!-- HOME -->
            <Grid x:Name="HomePage">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <StackPanel>
                        <TextBlock Text="Your kitchen, your canvas."
                                   Foreground="{StaticResource Ink}"
                                   FontSize="34"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="A calm place to discover, organize and create the food you love."
                                   Foreground="{StaticResource MutedInk}"
                                   FontSize="14"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Right"
                            Width="300"
                            Height="44"
                            Background="{StaticResource Panel}"
                            CornerRadius="13"
                            Padding="14,0">

                        <DockPanel>
                            <TextBlock Text="⌕"
                                       Foreground="{StaticResource MutedInk}"
                                       FontSize="19"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <TextBlock Text="Search your kitchen"
                                       Foreground="#737971"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                </Grid>

                <Border x:Name="HeroCard"
                        Grid.Row="1"
                        Margin="0,28,0,22"
                        CornerRadius="26"
                        Padding="34"
                        Height="250">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#302419" Offset="0"/>
                            <GradientStop Color="#1C2921" Offset="0.62"/>
                            <GradientStop Color="#15201A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>

                        <Ellipse Width="280"
                                 Height="280"
                                 Fill="#6A3A20"
                                 Opacity="0.18"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,-110,-80,0"/>

                        <Ellipse Width="180"
                                 Height="180"
                                 Fill="#6B8B61"
                                 Opacity="0.10"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,170,-105"/>

                        <StackPanel VerticalAlignment="Center"
                                    Width="650">

                            <TextBlock Text="WELCOME TO DISHLY"
                                       Foreground="{StaticResource Accent}"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Your next great meal starts with an empty page."
                                       Foreground="{StaticResource Ink}"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,9,0,0"/>

                            <TextBlock Text="We’ll keep the kitchen clean for now. Your recipes, favorites and shopping list will appear here when you add them."
                                       Foreground="#C7C0B5"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,18"/>

                            <StackPanel Orientation="Horizontal">

                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="My recipes"
                                        Click="MyRecipes_Click"
                                        Margin="0,0,8,0"/>

                                <Button Style="{StaticResource GhostButton}"
                                        Content="Discover"
                                        Click="Discover_Click"/>

                            </StackPanel>

                        </StackPanel>

                    </Grid>
                </Border>

                <DockPanel Grid.Row="2"
                           Margin="0,0,0,12">

                    <TextBlock Text="Your kitchen at a glance"
                               Foreground="{StaticResource Ink}"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                </DockPanel>

                <Grid Grid.Row="3">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource Panel}"
                            CornerRadius="18"
                            Margin="0,0,8,0"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="MY RECIPES"
                                       Foreground="{StaticResource MutedInk}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock Text="0"
                                       Foreground="{StaticResource Ink}"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,2"/>
                            <TextBlock Text="recipes created"
                                       Foreground="#747A73"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource Panel}"
                            CornerRadius="18"
                            Margin="8,0"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="FAVORITES"
                                       Foreground="{StaticResource MutedInk}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock Text="0"
                                       Foreground="{StaticResource Ink}"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,2"/>
                            <TextBlock Text="saved recipes"
                                       Foreground="#747A73"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource Panel}"
                            CornerRadius="18"
                            Margin="8,0,0,0"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="SHOPPING"
                                       Foreground="{StaticResource MutedInk}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock Text="0"
                                       Foreground="{StaticResource Ink}"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,2"/>
                            <TextBlock Text="items to buy"
                                       Foreground="#747A73"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                </Grid>

            </Grid>

            <!-- DISCOVER -->
            <Grid x:Name="DiscoverPage"
                  Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Discover"
                               Foreground="{StaticResource Ink}"
                               FontSize="34"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Recipe discovery will live here."
                               Foreground="{StaticResource MutedInk}"
                               FontSize="14"
                               Margin="0,6,0,18"/>

                    <TextBox x:Name="DiscoverSearchBox"
                             Style="{StaticResource FieldStyle}"
                             Height="46"
                             ToolTip="Search recipes or ingredients"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="No recipes yet"
                           Foreground="{StaticResource MutedInk}"
                           FontSize="12"
                           Margin="0,18,0,10"/>

                <Border Grid.Row="2"
                        Background="{StaticResource Panel}"
                        CornerRadius="20"
                        Padding="30"
                        MaxWidth="650"
                        MaxHeight="190">

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="The kitchen is still empty."
                                   Foreground="{StaticResource Ink}"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Once recipes are added, they will appear here."
                                   Foreground="{StaticResource MutedInk}"
                                   FontSize="13"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- FAVORITES -->
            <Grid x:Name="FavoritesPage"
                  Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Favorites"
                               Foreground="{StaticResource Ink}"
                               FontSize="34"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Keep the recipes you never want to lose."
                               Foreground="{StaticResource MutedInk}"
                               FontSize="14"
                               Margin="0,6,0,18"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{StaticResource Panel}"
                        CornerRadius="20"
                        Padding="30"
                        MaxWidth="650"
                        MaxHeight="190">

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Nothing saved yet."
                                   Foreground="{StaticResource Ink}"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Your favorite recipes will appear here."
                                   Foreground="{StaticResource MutedInk}"
                                   FontSize="13"
                                   Margin="0,7,0,0"/>
                    </StackPanel>

                </Border>

            </Grid>

            <!-- SHOPPING -->
            <Grid x:Name="ShoppingPage"
                  Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Shopping list"
                               Foreground="{StaticResource Ink}"
                               FontSize="34"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Build your grocery list as your kitchen grows."
                               Foreground="{StaticResource MutedInk}"
                               FontSize="14"
                               Margin="0,6,0,18"/>
                </StackPanel>

                <Grid Grid.Row="1"
                      Margin="0,0,0,18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ShoppingInput"
                             Style="{StaticResource FieldStyle}"
                             Height="44"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButton}"
                            Content="Add item"
                            Margin="10,0,0,0"
                            Click="AddShoppingItem_Click"/>

                </Grid>

                <Border Grid.Row="2"
                        Background="{StaticResource Panel}"
                        CornerRadius="20"
                        Padding="30"
                        MaxWidth="650"
                        MaxHeight="190">

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Your list is ready."
                                   Foreground="{StaticResource Ink}"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Add an ingredient above and it will appear here."
                                   Foreground="{StaticResource MutedInk}"
                                   FontSize="13"
                                   Margin="0,7,0,0"/>
                        <StackPanel x:Name="ShoppingItemsPanel"
                                    Margin="0,16,0,0"/>
                    </StackPanel>

                </Border>

            </Grid>

            <!-- MY RECIPES -->
            <Grid x:Name="MyRecipesPage"
                  Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="My recipes"
                               Foreground="{StaticResource Ink}"
                               FontSize="34"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Create your own recipes and keep your ideas in one place."
                               Foreground="{StaticResource MutedInk}"
                               FontSize="14"
                               Margin="0,6,0,18"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{StaticResource Panel}"
                        CornerRadius="18"
                        Padding="18"
                        Margin="0,0,0,18">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="0.55*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">
                            <TextBlock Text="Recipe name"
                                       Foreground="{StaticResource MutedInk}"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="MyRecipeTitleBox"
                                     Style="{StaticResource FieldStyle}"
                                     Height="42"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,10,0">
                            <TextBlock Text="Minutes"
                                       Foreground="{StaticResource MutedInk}"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="MyRecipeMinutesBox"
                                     Style="{StaticResource FieldStyle}"
                                     Height="42"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Description"
                                       Foreground="{StaticResource MutedInk}"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="MyRecipeDescriptionBox"
                                     Style="{StaticResource FieldStyle}"
                                     Height="42"/>
                        </StackPanel>

                        <Button Grid.Column="3"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource PrimaryButton}"
                                Content="Add recipe"
                                Click="AddMyRecipe_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource Panel}"
                        CornerRadius="20"
                        Padding="30"
                        MaxWidth="650"
                        MaxHeight="190">

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="No recipes yet."
                                   Foreground="{StaticResource Ink}"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Create your first recipe above and it will appear here."
                                   Foreground="{StaticResource MutedInk}"
                                   FontSize="13"
                                   Margin="0,7,0,0"/>
                    </StackPanel>

                </Border>

            </Grid>

        </Grid>
    </Grid>
</Window>