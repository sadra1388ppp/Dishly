<Window x:Class="Dishly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dishly"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        Background="{StaticResource Canvas}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInk}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter Property="Background" Value="#222A25"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RecipeCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2" Background="#0D100E" Padding="22,26">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="dishly" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="cook something memorable" Margin="1,2,0,26" Foreground="{StaticResource MutedInk}" FontSize="11"/>
                    <Button Style="{StaticResource NavButton}" Content="Home"/>
                    <Button Style="{StaticResource NavButton}" Content="Discover"/>
                    <Button Style="{StaticResource NavButton}" Content="Favorites"/>
                    <Button Style="{StaticResource NavButton}" Content="Shopping list"/>
                    <Button Style="{StaticResource NavButton}" Content="My recipes"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,30,0,0">
                    <Border Background="#1A1E1B" CornerRadius="16" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Kitchen tip" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Prep your ingredients before the pan gets hot." TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" Margin="0,7,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v0.1 • Dishly" Foreground="#656962" FontSize="10" Margin="2,16,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,30,34,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Good food starts here." FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="Discover recipes that fit your mood, your time, and your kitchen." Margin="0,6,0,0" Foreground="{StaticResource MutedInk}" FontSize="14"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Width="280" Background="{StaticResource Panel}" CornerRadius="14" Padding="14,10">
                    <DockPanel>
                        <TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource MutedInk}" Margin="2,0,10,0"/>
                        <TextBlock Text="Search recipes, ingredients..." VerticalAlignment="Center" Foreground="#777C74"/>
                    </DockPanel>
                </Border>
            </Grid>

            <Border x:Name="HeroCard" Grid.Row="1" Margin="0,26,0,24" CornerRadius="24" Padding="28">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B221B" Offset="0"/>
                        <GradientStop Color="#1B2520" Offset="0.62"/>
                        <GradientStop Color="#15201A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Ellipse Width="220" Height="220" Fill="#3A2417" Opacity="0.35" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-85,-45,0"/>
                    <Ellipse Width="150" Height="150" Fill="#314A32" Opacity="0.24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,110,-100"/>
                    <StackPanel Width="540">
                        <TextBlock Text="TODAY'S FEATURE" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Creamy garlic pasta" Foreground="White" FontSize="31" FontWeight="SemiBold" Margin="0,9,0,0"/>
                        <TextBlock Text="Silky sauce, roasted garlic and parmesan. Comfort food without the fuss." TextWrapping="Wrap" Foreground="#C8C1B6" FontSize="14" Margin="0,8,0,18"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource Accent}" CornerRadius="10" Padding="13,8" Margin="0,0,9,0">
                                <TextBlock Text="Open recipe" Foreground="#17120E" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#2B342E" CornerRadius="10" Padding="13,8">
                                <TextBlock Text="28 min  •  Easy" Foreground="#DDD8CF"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Left" Text="Popular this week" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                <TextBlock DockPanel.Dock="Right" Text="See all" Foreground="{StaticResource Accent}" VerticalAlignment="Bottom"/>
            </DockPanel>

            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource RecipeCard}" Width="235">
                        <StackPanel>
                            <Border Height="128" CornerRadius="14" Background="#303832">
                                <TextBlock Text="PASTA" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B6C1B3" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="Lemon herb pasta" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,13,0,4"/>
                            <TextBlock Text="20 min  •  Vegetarian" Foreground="{StaticResource MutedInk}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RecipeCard}" Width="235">
                        <StackPanel>
                            <Border Height="128" CornerRadius="14" Background="#39342A">
                                <TextBlock Text="BOWL" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C7B89E" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="Sesame chicken bowl" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,13,0,4"/>
                            <TextBlock Text="35 min  •  High protein" Foreground="{StaticResource MutedInk}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RecipeCard}" Width="235">
                        <StackPanel>
                            <Border Height="128" CornerRadius="14" Background="#26322A">
                                <TextBlock Text="BAKE" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AFC0AE" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="Honey roast carrots" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,13,0,4"/>
                            <TextBlock Text="30 min  •  Easy" Foreground="{StaticResource MutedInk}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
